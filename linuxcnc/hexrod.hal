# hexrod.hal
# HAL configuration for Mesa 7C81 (hm2_rpspi)
# LinuxCNC 2.9, trivkins, Axes: X (joint 0), Z (joint 1)

# ─── LOAD DRIVERS ─────────────────────────────────────────────────────────────
loadrt hostmot2
loadrt [HOSTMOT2](DRIVER) config=[HOSTMOT2](CONFIG)
loadrt trivkins coordinates=XZ
loadrt motmod base_period_nsec=0 servo_period_nsec=[EMCMOT](SERVO_PERIOD) num_joints=2

# ─── SERVO THREAD ─────────────────────────────────────────────────────────────
addf hm2_7c81.0.read          servo-thread
addf motion-command-handler    servo-thread
addf motion-controller         servo-thread
addf hm2_7c81.0.write         servo-thread

# ─── X AXIS (joint 0, stepgen 00, BOB P1 DB25 pins 2/3) ──────────────────────
setp hm2_7c81.0.stepgen.00.step_type      0
setp hm2_7c81.0.stepgen.00.position-scale [JOINT_0]SCALE
setp hm2_7c81.0.stepgen.00.maxvel         [JOINT_0]MAX_VELOCITY
setp hm2_7c81.0.stepgen.00.maxaccel       [JOINT_0]MAX_ACCELERATION
setp hm2_7c81.0.stepgen.00.steplen        [JOINT_0]STEPLEN
setp hm2_7c81.0.stepgen.00.stepspace      [JOINT_0]STEPSPACE
setp hm2_7c81.0.stepgen.00.dirhold        [JOINT_0]DIRHOLD
setp hm2_7c81.0.stepgen.00.dirsetup       [JOINT_0]DIRSETUP

net x-pos-cmd  joint.0.motor-pos-cmd  => hm2_7c81.0.stepgen.00.position-cmd
net x-pos-fb   joint.0.motor-pos-fb   <= hm2_7c81.0.stepgen.00.position-fb
net x-enable   joint.0.amp-enable-out => hm2_7c81.0.stepgen.00.enable

# ─── Z AXIS (joint 1, stepgen 02, BOB P1 DB25 pins 6/7) ──────────────────────
setp hm2_7c81.0.stepgen.02.step_type      0
setp hm2_7c81.0.stepgen.02.position-scale [JOINT_1]SCALE
setp hm2_7c81.0.stepgen.02.maxvel         [JOINT_1]MAX_VELOCITY
setp hm2_7c81.0.stepgen.02.maxaccel       [JOINT_1]MAX_ACCELERATION
setp hm2_7c81.0.stepgen.02.steplen        [JOINT_1]STEPLEN
setp hm2_7c81.0.stepgen.02.stepspace      [JOINT_1]STEPSPACE
setp hm2_7c81.0.stepgen.02.dirhold        [JOINT_1]DIRHOLD
setp hm2_7c81.0.stepgen.02.dirsetup       [JOINT_1]DIRSETUP

net z-pos-cmd  joint.1.motor-pos-cmd  => hm2_7c81.0.stepgen.02.position-cmd
net z-pos-fb   joint.1.motor-pos-fb   <= hm2_7c81.0.stepgen.02.position-fb
net z-enable   joint.1.amp-enable-out => hm2_7c81.0.stepgen.02.enable

# ─── A AXIS / DIVIDING HEAD (joint 2, stepgen 03) ─────────────────────────────
# Uncomment when dividing head stepper is connected.
# Also set num_joints=3 in motmod above and add [JOINT_2] to INI.
#setp hm2_7c81.0.stepgen.03.step_type      0
#setp hm2_7c81.0.stepgen.03.position-scale [JOINT_2]SCALE
#setp hm2_7c81.0.stepgen.03.maxvel         [JOINT_2]MAX_VELOCITY
#setp hm2_7c81.0.stepgen.03.maxaccel       [JOINT_2]MAX_ACCELERATION
#setp hm2_7c81.0.stepgen.03.steplen        [JOINT_2]STEPLEN
#setp hm2_7c81.0.stepgen.03.stepspace      [JOINT_2]STEPSPACE
#setp hm2_7c81.0.stepgen.03.dirhold        [JOINT_2]DIRHOLD
#setp hm2_7c81.0.stepgen.03.dirsetup       [JOINT_2]DIRSETUP
#net a-pos-cmd  joint.2.motor-pos-cmd  => hm2_7c81.0.stepgen.03.position-cmd
#net a-pos-fb   joint.2.motor-pos-fb   <= hm2_7c81.0.stepgen.03.position-fb
#net a-enable   joint.2.amp-enable-out => hm2_7c81.0.stepgen.03.enable

# ─── HOME / LIMIT SWITCHES ────────────────────────────────────────────────────
# BOB input terminals → 7C81 GPIO (NC switches, wire between terminal and COM/GND)
#
#   DB25 pin 10  IO13  gpio.013  X min / home  (negative end)
#   DB25 pin 11  IO14  gpio.014  X max limit   (positive end)
#   DB25 pin 12  IO15  gpio.015  Z max limit   (positive end)
#   DB25 pin 13  IO16  gpio.016  Z min / home  (negative end)
#
setp hm2_7c81.0.gpio.013.is_output 0
setp hm2_7c81.0.gpio.014.is_output 0
setp hm2_7c81.0.gpio.015.is_output 0
setp hm2_7c81.0.gpio.016.is_output 0
net x-min-home  joint.0.home-sw-in  joint.0.neg-lim-sw-in  <=  hm2_7c81.0.gpio.013.in
net x-max       joint.0.pos-lim-sw-in                      <=  hm2_7c81.0.gpio.014.in
net z-min-home  joint.1.home-sw-in  joint.1.neg-lim-sw-in  <=  hm2_7c81.0.gpio.016.in
net z-max       joint.1.pos-lim-sw-in                      <=  hm2_7c81.0.gpio.015.in

# ─── E-STOP ───────────────────────────────────────────────────────────────────
# No hardware e-stop wired - hold emc-enable-in high permanently
# Replace with a real e-stop switch connection when hardware is added
setp iocontrol.0.emc-enable-in 1
